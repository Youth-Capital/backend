# Secrets — never commit.
# The real .env holds DJANGO_SECRET_KEY, the database URL and ANTHROPIC_API_KEY.
# Copy .env.example instead; that one is safe to publish.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Django — dev.sqlite3 holds real accounts, password hashes and uploads.
*.sqlite3
media/
staticfiles/
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
