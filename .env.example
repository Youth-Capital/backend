# Copy to backend/.env and fill in. NEVER commit the real .env.

# --- Core ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
# Neon / Supabase connection string, e.g.
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/yoshlar?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# Used only when DATABASE_URL is empty (local PostgreSQL).
POSTGRES_DB=yoshlar_kapitali
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Frontend / CORS ----------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
# Must be True in production (https only).
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- Domain rules -------------------------------------------------------
MINIMUM_AGE=14
AGE_OF_MAJORITY=18

# --- AI -----------------------------------------------------------------
# RULE_BASED needs no key and makes no external calls.
AI_DEFAULT_PROVIDER=RULE_BASED
# Keep False outside controlled debugging: prompts contain personal data.
AI_LOG_PROMPT_CONTENT=False
# The key itself lives here; the database stores only this variable's NAME.
# ANTHROPIC_API_KEY=

# --- Email (console backend in dev) ------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@yoshlarkapitali.uz

# --- Optional -----------------------------------------------------------
# Leave empty to run recomputation synchronously.
CELERY_BROKER_URL=
SENTRY_DSN=
